sed -i -e "s|quay.io/rhobs/obo-admission-webhook.*|${COO_ADMISSION_WEBHOOK_IMAGE_URL}|g" "$csv_file"
sed -i -e "s|quay.io/persesdev/perses-operator.*|${COO_PERSES_OPERATOR_IMAGE_URL}|g" "$csv_file"

