yq -i '(.spec.install.spec.deployments[] | select(.name == "observability-operator").spec.template.spec.containers[] | select(.name == "operator").args) +=  ["--images=health-analyzer=$(RELATED_IMAGE_CLUSTER_HEALTH_ANALYZER)"]' "$csv_file"
