VALUE="${COO_PERSES_OPERATOR_IMAGE_URL}" yq -i '(.spec.relatedImages += [{"name":"perses-operator", "image": strenv(VALUE)}])' "$csv_file"

# Replace quay.io/rhobs image urls with registry-proxy.engineering.redhat.com/
