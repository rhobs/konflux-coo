FROM brew.registry.redhat.io/rh-osbs/openshift-golang-builder:rhel_9_1.26 as builder
USER root

RUN dnf install -y --setopt=tsflags=nodocs mailcap && \
    dnf clean all && \
    rm -rf /var/cache/dnf

WORKDIR /app

COPY perses/ .

ENV GOFLAGS="-mod=readonly"
ENV CGO_ENABLED=1
ENV GOEXPERIMENT=strictfipsruntime

RUN go mod download

RUN mkdir /plugins

# Run generate steps (assets compression, plugin installation)
RUN make generate

# CGO required for FIPS/check-payload; upstream Makefile uses CGO_ENABLED=0 — build here instead
RUN go build -tags strictfipsruntime -ldflags "-s -w" -o ./bin/perses ./cmd/perses
RUN go build -tags strictfipsruntime -ldflags "-s -w" -o ./bin/percli ./cmd/percli

# Build a minimal runtime rootfs on ubi-micro: install FIPS-capable OpenSSL, CA
# certificates and tzdata via dnf --installroot so the RPM database is preserved
# and vulnerability scanners can correctly identify the installed packages. The
# application artifacts are assembled here too, since ubi-micro has no shell to
# run chown/chmod in the final stage.
FROM registry.redhat.io/ubi9/ubi-micro:latest@sha256:7e7f79ab747bf2b452e3043dd89f388e92be4c7fdcc8b815b58adf6c99c39c95 AS runtime-base

FROM registry.redhat.io/ubi9/ubi:latest@sha256:5426a8f45e80a07168a30ea24d84f266094b3756624a5508cc53927e6ee39e09 AS runtime-rootfs
COPY --from=runtime-base / /mnt/rootfs/
RUN dnf install -y --installroot=/mnt/rootfs --setopt=reposdir=/etc/yum.repos.d \
        --setopt=install_weak_deps=0 --setopt=tsflags=nodocs --releasever=9 \
        openssl-libs ca-certificates tzdata && \
    dnf clean all --installroot=/mnt/rootfs && \
    rm -rf /mnt/rootfs/var/cache/* /mnt/rootfs/var/log/dnf* /mnt/rootfs/tmp/*

COPY --from=builder  /app/bin/perses                         /mnt/rootfs/bin/perses
COPY --from=builder  /app/bin/percli                         /mnt/rootfs/bin/percli
COPY --from=builder  /app/docs/examples/config.docker.yaml   /mnt/rootfs/etc/perses/config.yaml
COPY --from=builder  /app/plugins-archive/                   /mnt/rootfs/etc/perses/plugins-archive/
COPY --from=builder  /app/LICENSE                            /mnt/rootfs/LICENSE
COPY --from=builder  /plugins                                /mnt/rootfs/etc/perses/plugins
COPY --from=builder  /etc/mime.types                         /mnt/rootfs/etc/mime.types

RUN chown -R 65534:0 /mnt/rootfs/etc/perses && \
    chmod -R g=u /mnt/rootfs/etc/perses && \
    mkdir -p /mnt/rootfs/perses && \
    chgrp -R 0 /mnt/rootfs/perses && \
    chmod -R g=u /mnt/rootfs/perses

FROM registry.redhat.io/ubi9/ubi-micro:latest@sha256:7e7f79ab747bf2b452e3043dd89f388e92be4c7fdcc8b815b58adf6c99c39c95
COPY --from=runtime-rootfs /mnt/rootfs/ /

LABEL maintainer="Observability UI team <team-observability-ui@redhat.com>"

WORKDIR /perses

USER 65534

EXPOSE     8080
VOLUME     ["/perses"]
ENTRYPOINT [ "/bin/perses" ]
CMD        ["--config=/etc/perses/config.yaml", "--log.level=error"]

ARG VERSION=v0.54.0
LABEL com.redhat.component="coo-perses" \
    name="cluster-observability-operator/perses-rhel9" \
      cpe="cpe:/a:redhat:cluster_observability_operator:1.5::el9" \
    version="${VERSION}" \
    release="${VERSION}" \
    vendor="Red Hat, Inc." \
    distribution-scope="public" \
    url="https://github.com/rhobs/perses" \
    summary="Perses for Cluster Observability Operator" \
    io.openshift.tags="openshift,observability-ui,perses" \
    io.k8s.display-name="Perses for Cluster Observability Operator" \
    io.k8s.description="Perses for Cluster Observability Operator" \
    maintainer="Observability UI Team <team-observability-ui@redhat.com>" \
    description="Perses for Cluster Observability Operator"
