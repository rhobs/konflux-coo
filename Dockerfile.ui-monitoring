FROM registry.redhat.io/ubi9/nodejs-22:latest AS web-builder

WORKDIR /opt/app-root

USER 0

ENV HUSKY=0
COPY ui-monitoring/web/package*.json web/
COPY ui-monitoring/Makefile Makefile
RUN make install-frontend-ci

COPY ui-monitoring/web/ web/
COPY ui-monitoring/config/ config/

ENV CONSOLE_PLUGIN_NAME="monitoring-console-plugin"
RUN make build-frontend

FROM brew.registry.redhat.io/rh-osbs/openshift-golang-builder:rhel_9_1.26 as go-builder

WORKDIR /opt/app-root

COPY ui-monitoring/Makefile Makefile
COPY ui-monitoring/go.mod go.mod
COPY ui-monitoring/go.sum go.sum

RUN make install-backend

COPY ui-monitoring/cmd/ cmd/
COPY ui-monitoring/pkg/ pkg/

ENV GOOS=${TARGETOS:-linux}
ENV GOARCH=${TARGETARCH}
ENV GOEXPERIMENT=strictfipsruntime
ENV GOFLAGS=-mod=readonly
ENV CGO_ENABLED=1

RUN make build-backend

# Build a minimal runtime rootfs on ubi-micro: install FIPS-capable OpenSSL, CA
# certificates and tzdata via dnf --installroot so the RPM database is preserved
# and vulnerability scanners can correctly identify the installed packages.
FROM registry.redhat.io/ubi9/ubi-micro:latest@sha256:7e7f79ab747bf2b452e3043dd89f388e92be4c7fdcc8b815b58adf6c99c39c95 AS runtime-base

FROM registry.redhat.io/ubi9/ubi:latest@sha256:5426a8f45e80a07168a30ea24d84f266094b3756624a5508cc53927e6ee39e09 AS runtime-rootfs
COPY --from=runtime-base / /mnt/rootfs/
RUN dnf install -y --installroot=/mnt/rootfs --setopt=reposdir=/etc/yum.repos.d \
        --setopt=install_weak_deps=0 --setopt=tsflags=nodocs --releasever=9 \
        openssl-libs ca-certificates tzdata && \
    dnf clean all --installroot=/mnt/rootfs && \
    rm -rf /mnt/rootfs/var/cache/* /mnt/rootfs/var/log/dnf* /mnt/rootfs/tmp/*

FROM registry.redhat.io/ubi9/ubi-micro:latest@sha256:7e7f79ab747bf2b452e3043dd89f388e92be4c7fdcc8b815b58adf6c99c39c95
COPY --from=runtime-rootfs /mnt/rootfs/ /
COPY ui-monitoring/LICENSE /licenses/.

USER 1001

COPY --from=web-builder /opt/app-root/web/dist /opt/app-root/web/dist
COPY --from=go-builder /opt/app-root/plugin-backend /opt/app-root
COPY --from=web-builder /opt/app-root/config /opt/app-root/config

ENTRYPOINT ["/opt/app-root/plugin-backend", "-static-path", "/opt/app-root/web/dist"]

ARG VERSION=v1.0.0
LABEL com.redhat.component="coo-monitoring-console-plugin" \
      name="cluster-observability-operator/monitoring-console-plugin-rhel9" \
      cpe="cpe:/a:redhat:cluster_observability_operator:1.5::el9" \
      version="${VERSION}" \
      release="${VERSION}" \
      vendor="Red Hat, Inc." \
      distribution-scope="public" \
      url="https://github.com/openshift/monitoring-plugin" \
      summary="OpenShift monitoring plugin to view and explore metrics and alerts" \
      io.openshift.tags="openshift,observability-ui,metrics,alerts" \
      io.k8s.display-name="OpenShift console monitoring plugin" \
      io.k8s.description="OpenShift monitoring plugin to view and explore metrics and alerts" \
      maintainer="Observability UI Team <team-observability-ui@redhat.com>" \
      description="OpenShift monitoring plugin to view and explore metrics and alerts"
