FROM brew.registry.redhat.io/rh-osbs/openshift-golang-builder:rhel_9_1.25 as builder
WORKDIR /workspace

# Copy source files
COPY obo-prometheus-operator/ .

ENV GOFLAGS='-mod=readonly -tags=timetzdata'
ENV CGO_ENABLED=1
ENV GOEXPERIMENT=strictfipsruntime

# CGO required for FIPS/check-payload; upstream Makefile uses CGO_ENABLED=0 — build here instead
RUN go build -tags strictfipsruntime -ldflags "-s -w" -o prometheus-config-reloader ./cmd/prometheus-config-reloader

# Build a minimal runtime rootfs on ubi-micro: install FIPS-capable OpenSSL, CA
# certificates and tzdata via dnf --installroot so the RPM database is preserved
# and vulnerability scanners can correctly identify the installed packages.
FROM registry.redhat.io/ubi9/ubi-micro:latest@sha256:7e7f79ab747bf2b452e3043dd89f388e92be4c7fdcc8b815b58adf6c99c39c95 AS runtime-base

FROM registry.redhat.io/ubi9/ubi:latest@sha256:5426a8f45e80a07168a30ea24d84f266094b3756624a5508cc53927e6ee39e09 AS runtime-rootfs
COPY --from=runtime-base / /mnt/rootfs/
RUN dnf install -y --installroot=/mnt/rootfs --setopt=reposdir=/etc/yum.repos.d \
        --setopt=install_weak_deps=0 --setopt=tsflags=nodocs --releasever=9 \
        openssl-libs ca-certificates tzdata && \
    dnf clean all --installroot=/mnt/rootfs && \
    rm -rf /mnt/rootfs/var/cache/* /mnt/rootfs/var/log/dnf* /mnt/rootfs/tmp/*

FROM registry.redhat.io/ubi9/ubi-micro:latest@sha256:7e7f79ab747bf2b452e3043dd89f388e92be4c7fdcc8b815b58adf6c99c39c95
COPY --from=runtime-rootfs /mnt/rootfs/ /

COPY --from=builder workspace/prometheus-config-reloader /bin/prometheus-config-reloader
COPY --from=builder /workspace/LICENSE      /licenses/.

USER nobody

ENTRYPOINT ["/bin/prometheus-config-reloader"]

ARG VERSION=v0.89.0
LABEL com.redhat.component="coo-po-prometheus-config-reloader" \
      name="cluster-observability-operator/obo-prometheus-operator-prometheus-config-reloader-rhel9" \
      cpe="cpe:/a:redhat:cluster_observability_operator:1.5::el9" \
      version="${VERSION}" \
      release="${VERSION}" \
      vendor="Red Hat, Inc." \
      distribution-scope="public" \
      url="https://github.com/rhobs/obo-prometheus-operator" \
      summary="Prometheus Config Reloader for Prometheus Operator" \
      io.openshift.tags="monitoring" \
      io.k8s.display-name="Prometheus Config Reloader for Prometheus Operator" \
      io.k8s.description="Prometheus Config Reloader for Prometheus Operator" \
      maintainer="OpenShift Monitoring team <team-monitoring-incluster@redhat.com>" \
      description="Prometheus Config Reloader for Prometheus Operator"
